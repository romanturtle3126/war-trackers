{
  "name": "world-conflicts-map",
  "private": true,
  "version": "1.0.0",
  "description": "World Conflicts Map: sourced, status-labelled events from current wars (Ukraine, Middle East) on a map, as a web page and an Android app.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs data/ukraine.json",
    "build:web": "node scripts/build-web.mjs",
    "merge": "node scripts/merge-update.mjs",
    "feeds": "node scripts/fetch-feeds.mjs ukraine",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
